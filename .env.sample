# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=xxxxxxxx
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_NAME=your_database_name
DB_SCHEMA=public

# Prisma connection string (auto-composed from variables above)
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}"
# Required by Prisma. Local: same as DATABASE_URL. Neon/Vercel: use direct (non-pooler) URL from Neon dashboard.
DIRECT_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}"

# Set to true if you use your own PostgreSQL (not Docker from docker-compose)
# SKIP_DOCKER=true

# Prisma: yarn dev skips `prisma generate` when client exists (avoids Windows EPERM)
# PRISMA_GENERATE_ON_DEV=true   # force generate on every yarn dev
# PRISMA_GENERATE_ON_DEV=false  # never generate on yarn dev

# NextAuth
NEXTAUTH_SECRET="your-random-secret-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Email — contact form notifications to admin inbox + Gmail
# Option A (recommended): Gmail SMTP — use App Password from Google Account
# https://myaccount.google.com/apppasswords
GMAIL_USER="contact.fgssoftware@gmail.com"
GMAIL_APP_PASSWORD=""
GMAIL_FROM="contact.fgssoftware@gmail.com"
CONTACT_ADMIN_EMAIL="contact.fgssoftware@gmail.com"

# Option B: Resend — https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM="FGS Software <onboarding@resend.dev>"

ADMIN_EMAIL="contact.fgssoftware@gmail.com"
ADMIN_EMAIL_CC=""

# Google Maps (admin Settings → address autocomplete & Contact page map)
GOOGLE_MAPS_API_KEY=""

# AI Chatbot
# AI_PROVIDER=auto|openai|gemini  (auto: Gemini first, then OpenAI — recommended)
AI_PROVIDER=auto
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Free tier: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Redis cache (optional — speeds up repeated DB reads)
REDIS_URL=""

# Admin seed account (used only on first `yarn db:seed`)
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="your-secure-password-here"

# Hidden admin login path (min 8 chars). When set, /admin/login returns 404.
# Login URL becomes: http://localhost:3000/access/YOUR_SECRET_PATH
# ADMIN_LOGIN_PATH="fgs-portal-change-me-8xk2"
# Must match ADMIN_LOGIN_PATH (used for client-side logout redirect on secret URL)
# NEXT_PUBLIC_ADMIN_LOGIN_PATH="fgs-portal-change-me-8xk2"

# Public site URL (for emails, SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# File uploads on Vercel (local public/uploads is NOT persisted — add vars on Vercel too)
# Priority: Cloudinary → Vercel Blob → local disk (override with UPLOAD_STORAGE)
# Dashboard: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Vercel → Storage → Blob → .env.local → BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=""

# Optional: cloudinary | blob | local
UPLOAD_STORAGE=""

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=""
